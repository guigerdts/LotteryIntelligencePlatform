# LIP backend environment template.
#
# Copy this file to `backend/.env` and adjust for local development, or export
# the variables with the same names. Config precedence is deterministic:
# built-in defaults < `.env`/environment overrides (prefix LIP_). Values below
# are PLACEHOLDERS only — never commit real secrets here.

# --- app ---
LIP_APP_NAME=lip-backend
LIP_APP_VERSION=0.1.0
LIP_DEBUG=false

# --- api ---
LIP_API_V1_PREFIX=/api/v1
LIP_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- database (SQLite default; swap URL for PostgreSQL later) ---
LIP_DATABASE_URL=sqlite:///./database/lip.db

# --- logging ---
LIP_LOGGING_LEVEL=INFO